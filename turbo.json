{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "dependsOn": [
        "build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build",
        "^test"
      ],
      "env": [
        "HF_TEST_DATABASE_URL"
      ]
    },
    "api-extractor": {
      "dependsOn": [
        "build"
      ]
    },
    "api-extractor:update": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    }
  }
}
