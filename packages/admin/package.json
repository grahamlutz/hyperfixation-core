{
  "name": "@hyperfixation/admin",
  "version": "0.1.7",
  "license": "MIT",
  "description": "Admin router and resource definitions generated from Drizzle metadata",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grahamlutz/hyperfixation-core.git",
    "directory": "packages/admin"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/test-support/**"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "api-extractor": "api-extractor run",
    "api-extractor:update": "api-extractor run --local",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@hyperfixation/ai": "workspace:*",
    "@hyperfixation/eslint-config": "workspace:*",
    "@hyperfixation/testing": "workspace:*",
    "@microsoft/api-extractor": "^7.59.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0"
  },
  "dependencies": {
    "@hyperfixation/auth": "workspace:*",
    "@hyperfixation/core": "workspace:*",
    "@hyperfixation/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  }
}
