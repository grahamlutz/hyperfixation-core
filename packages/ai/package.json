{
  "name": "@hyperfixation/ai",
  "version": "0.1.0",
  "description": "Provider registry, prompt files by content hash, llm.run with the ledger and budget, Langfuse wiring",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grahamlutz/hyperfixation-core.git",
    "directory": "packages/ai"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/test-support/**"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "api-extractor": "api-extractor run",
    "api-extractor:update": "api-extractor run --local",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.54",
    "@ai-sdk/openai": "4.0.67",
    "@ai-sdk/otel": "1.0.102",
    "@ai-sdk/provider": "^4.0.15",
    "@hyperfixation/db": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "ai": "7.0.102",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@dbos-inc/dbos-sdk": "4.27.6",
    "@hyperfixation/core": "workspace:*",
    "@hyperfixation/eslint-config": "workspace:*",
    "@hyperfixation/testing": "workspace:*",
    "@hyperfixation/workflows": "workspace:*",
    "@microsoft/api-extractor": "^7.59.1",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0"
  }
}
