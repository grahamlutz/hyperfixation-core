{
  "name": "@hyperfixation/tools",
  "version": "0.0.0",
  "private": true,
  "description": "Maintainer scripts: nothing here ships to users",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "template-check": "tsx src/template-check.ts",
    "release-publish": "tsx src/publish.ts",
    "release-rehearse": "tsx src/rehearse.ts",
    "release-verify": "tsx src/verify.ts",
    "plan-sync": "tsx src/plan-sync.ts"
  },
  "devDependencies": {
    "@hyperfixation/eslint-config": "workspace:*",
    "eslint": "^10.10.0",
    "tsx": "4.23.13",
    "verdaccio": "6.10.3",
    "yaml": "2.9.1"
  }
}
