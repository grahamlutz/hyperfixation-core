{
  "name": "@hyperfixation/tools",
  "version": "0.0.0",
  "private": true,
  "description": "Maintainer scripts: nothing here ships to users",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "template-check": "tsx src/template-check.ts",
    "scaffold-check": "tsx src/scaffold-check.ts",
    "api-diff": "tsx src/api-diff.ts",
    "downstream-matrix": "tsx src/downstream-matrix-ci.ts",
    "release-publish": "tsx src/publish.ts",
    "release-rehearse": "tsx src/rehearse.ts",
    "release-ci": "tsx src/publish-ci.ts",
    "release-verify": "tsx src/verify.ts",
    "plan-sync": "tsx src/plan-sync.ts",
    "dev-doctor": "tsx src/dev-doctor.ts",
    "dev-clean": "tsx src/dev-clean.ts",
    "worktrees-clean": "tsx src/worktrees-clean.ts",
    "with-load": "tsx src/with-load.ts"
  },
  "devDependencies": {
    "@hyperfixation/eslint-config": "workspace:*",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0",
    "pg": "^8.23.0",
    "tsx": "4.23.13",
    "verdaccio": "6.10.3",
    "yaml": "2.9.1"
  }
}
