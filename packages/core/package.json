{
  "name": "@hyperfixation/core",
  "version": "0.0.0",
  "description": "defineApp, registries, resolution, records, activity, tasks, labels, outcomes, and the status endpoint",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "api-extractor": "api-extractor run",
    "api-extractor:update": "api-extractor run --local",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "4.27.6",
    "@hyperfixation/db": "workspace:*",
    "@hyperfixation/workflows": "workspace:*",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@hyperfixation/eslint-config": "workspace:*",
    "@hyperfixation/testing": "workspace:*",
    "@microsoft/api-extractor": "^7.59.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0"
  }
}
