{
  "name": "@hyperfixation/auth",
  "version": "0.1.6",
  "license": "MIT",
  "description": "better-auth factory, session-factor policy, requireSession, and the bootstrap user",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grahamlutz/hyperfixation-core.git",
    "directory": "packages/auth"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "api-extractor": "api-extractor run",
    "api-extractor:update": "api-extractor run --local",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@hyperfixation/eslint-config": "workspace:*",
    "@hyperfixation/testing": "workspace:*",
    "@microsoft/api-extractor": "^7.59.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.5",
    "@hyperfixation/db": "workspace:*",
    "@simplewebauthn/server": "13.3.3",
    "better-auth": "1.7.5",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "zod": "4.6.5"
  }
}
