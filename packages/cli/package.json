{
  "name": "@hyperfixation/cli",
  "version": "0.1.6",
  "license": "MIT",
  "description": "The hf binary and its Turborepo generator templates",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grahamlutz/hyperfixation-core.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "bin": {
    "hf": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/test-support/**"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "api-extractor": "api-extractor run",
    "api-extractor:update": "api-extractor run --local",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hyperfixation/auth": "workspace:*",
    "@hyperfixation/core": "workspace:*",
    "@hyperfixation/db": "workspace:*",
    "giget": "3.3.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@hyperfixation/eslint-config": "workspace:*",
    "@hyperfixation/testing": "workspace:*",
    "@microsoft/api-extractor": "^7.59.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0",
    "msw": "2.15.0",
    "openapi-request-validator": "12.1.3"
  }
}
