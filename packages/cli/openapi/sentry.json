    "/api/0/projects/{organization_id_or_slug}/{project_id_or_slug}/keys/": {
      "get": {
        "operationId": "listProjectKeys",
        "description": "Return a list of client keys bound to a project.",
        "summary": "List a Project's Client Keys",
