{
  "name": "@hyperfixation/testing",
  "version": "0.1.3",
  "license": "MIT",
  "description": "Vitest helpers: per-run database, recorded LLM, runFlowSync, and the spawnWorker/killAt crash harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grahamlutz/hyperfixation-core.git",
    "directory": "packages/testing"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker-module.d.ts",
      "default": "./dist/worker-module.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/test-modules/**"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "api-extractor": "api-extractor run && api-extractor run -c api-extractor.worker-module.json",
    "api-extractor:update": "api-extractor run --local && api-extractor run --local -c api-extractor.worker-module.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.15",
    "@dbos-inc/dbos-sdk": "4.27.6",
    "@hyperfixation/db": "workspace:*",
    "ai": "^7.0.102",
    "pg": "^8.23.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@hyperfixation/eslint-config": "workspace:*",
    "@microsoft/api-extractor": "^7.59.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0"
  }
}
