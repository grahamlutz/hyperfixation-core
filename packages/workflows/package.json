{
  "name": "@hyperfixation/workflows",
  "version": "0.1.1",
  "license": "MIT",
  "description": "startWorker, defineFlow and the run lifecycle, the step wrapper, approvals, actions, queues, and the reconciler",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grahamlutz/hyperfixation-core.git",
    "directory": "packages/workflows"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/test-support/**"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "api-extractor": "api-extractor run",
    "api-extractor:update": "api-extractor run --local",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "4.27.6",
    "@hyperfixation/db": "workspace:*",
    "@langfuse/otel": "5.11.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.220.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hyperfixation/eslint-config": "workspace:*",
    "@hyperfixation/testing": "workspace:*",
    "@microsoft/api-extractor": "^7.59.1",
    "@sentry/node": "^10.74.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.10.0"
  }
}
